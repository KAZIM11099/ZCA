# Frontend build-time configuration; VITE_ values are public in the browser bundle.
# Set VITE_API_URL to the API's /api/v1 base URL for each environment.
VITE_API_URL=http://localhost:4000/api/v1
VITE_SITE_URL=https://zavikoocustomatelier.com
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA4_ID=G-5ZW05H955R
# Use the same public Web OAuth client ID as backend GOOGLE_CLIENT_ID.
# Add each site origin (for example, http://localhost:5173) to its authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
