# ZAVIKOO - React SPA routing for Hostinger (Apache / LiteSpeed)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Asli files/folders (assets, images, sitemap.xml, robots.txt etc.) waisay hi serve hon
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Baaki har route (/shop, /product/xyz, /admin/login ...) index.html par jaye
  RewriteRule ^ index.html [L]
</IfModule>

# Assets ki caching (Vite ke hashed files)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
