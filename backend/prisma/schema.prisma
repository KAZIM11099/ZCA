// Money is stored as integer paisa (PKR minor units) to avoid float errors.
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  SUPPORT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNAVAILABLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DesignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               Role                @default(CUSTOMER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  sessions           Session[]
  orders             Order[]
  designs            CustomDesign[]
  auditLogs          AuditLog[]
  quotes             Quote[]
  inventoryMovements InventoryMovement[]
  addresses          Address[]
  passwordResetTokens PasswordResetToken[]
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String   @db.VarChar(80)
  recipient  String   @db.VarChar(191)
  phone      String   @db.VarChar(40)
  line1      String   @db.VarChar(191)
  line2      String?  @db.VarChar(191)
  city       String   @db.VarChar(100)
  province   String   @db.VarChar(100)
  postalCode String?  @db.VarChar(30)
  country    String   @default("Pakistan") @db.VarChar(100)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.Char(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Category {
  id        Int             @id @default(autoincrement())
  name      String
  slug      String          @unique
  parentId  Int?
  parent    Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]      @relation("CategoryTree")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  products  Product[]
  carousels CarouselImage[]
}

model Collection {
  id                  Int                 @id @default(autoincrement())
  name                String
  slug                String              @unique
  description         String?             @db.Text
  bannerImageData     Bytes?              @db.LongBlob
  bannerImageMimeType String?             @db.VarChar(32)
  isActive            Boolean             @default(true)
  items               CollectionProduct[]
  carousels           CarouselImage[]
}

model CarouselImage {
  id           Int        @id @default(autoincrement())
  collectionId Int
  categoryId   Int
  productId    Int?
  modelImage   String     @db.LongText
  productImage String     @db.LongText
  description  String     @db.VarChar(50)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id])
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([collectionId, createdAt])
  @@index([productId])
}

model HeroImage {
  id        Int      @id @default(autoincrement())
  imageData Bytes    @db.LongBlob
  mimeType  String   @db.VarChar(32)
  sortOrder Int      @unique
  createdAt DateTime @default(now())
}

model HeaderAnnouncement {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(250)
  sortOrder Int      @unique
  createdAt DateTime @default(now())
}

model CollectionProduct {
  collectionId Int
  productId    Int
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id               Int                 @id @default(autoincrement())
  name             String
  slug             String              @unique
  sku              String              @unique
  description      String?             @db.Text
  material         String?
  careInstructions String?             @db.Text
  basePricePaisa   Int
  salePricePaisa   Int?
  status           ProductStatus       @default(DRAFT)
  isMadeToOrder    Boolean             @default(false)
  isCustomizable   Boolean             @default(false)
  isFeatured       Boolean             @default(false)
  categoryId       Int
  category         Category            @relation(fields: [categoryId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  collections      CollectionProduct[]
  carousels        CarouselImage[]
  reviews          ProductReview[]
  designs          CustomDesign[]

  @@index([status, createdAt])
}

model CustomProduct {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(191)
  slug           String         @unique @db.VarChar(191)
  sku            String         @unique @db.VarChar(191)
  garmentType    String         @db.VarChar(40)
  description    String?        @db.Text
  basePricePaisa Int
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  designs        CustomDesign[]

  @@index([isActive, createdAt])
}

model ProductReview {
  id            Int                 @id @default(autoincrement())
  productId     Int
  reviewerName  String              @db.VarChar(100)
  reviewerEmail String              @db.VarChar(191)
  rating        Int
  comment       String              @db.Text
  status        ProductReviewStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([reviewerEmail])
}

model ProductVariant {
  id                 Int                 @id @default(autoincrement())
  productId          Int
  sku                String              @unique
  size               String
  color              String
  stockQty           Int                 @default(0)
  lowStockAt         Int                 @default(5)
  priceDeltaPaisa    Int                 @default(0)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@unique([productId, size, color])
}

model ProductImage {
  id         Int     @id @default(autoincrement())
  productId  Int
  storageKey String  @db.LongText
  altText    String
  sortOrder  Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CustomDesign {
  id              Int            @id @default(autoincrement())
  userId          Int?
  productId       Int?
  customProductId Int?
  schemaVersion   Int            @default(1)
  layoutJson      Json
  status          DesignStatus   @default(DRAFT)
  rightsConfirmed Boolean        @default(false)
  createdAt       DateTime       @default(now())
  user            User?          @relation(fields: [userId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customProduct   CustomProduct? @relation(fields: [customProductId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]

  @@index([userId, createdAt])
}

model InventoryMovement {
  id             Int            @id @default(autoincrement())
  variantId      Int
  actorId        Int?
  quantityChange Int
  reason         String         @db.VarChar(191)
  createdAt      DateTime       @default(now())
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  percentOff     Int?
  amountOffPaisa Int?
  minOrderPaisa  Int       @default(0)
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
}

model Quote {
  id               Int               @id @default(autoincrement())
  name             String
  email            String
  projectType      String
  quantity         Int               @default(1)
  details          String            @db.Text
  status           QuoteStatus       @default(NEW)
  quotedPricePaisa Int?
  internalNotes    String?           @db.Text
  userId           Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  designImage      QuoteDesignImage?

  @@index([status, createdAt])
  @@index([email])
}

model QuoteDesignImage {
  id        Int      @id @default(autoincrement())
  quoteId   Int      @unique
  imageData Bytes    @db.LongBlob
  mimeType  String   @db.VarChar(32)
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        Int                  @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(191)
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  userId          Int?
  email           String
  phone           String
  whatsappOptIn   Boolean     @default(false)
  shippingAddress Json
  status          OrderStatus @default(PENDING)
  currency        String      @default("PKR")
  subtotalPaisa   Int
  discountPaisa   Int         @default(0)
  shippingPaisa   Int         @default(0)
  totalPaisa      Int
  customerNotes   String?     @db.Text
  idempotencyKey  String?     @unique
  idempotencyHash String?     @db.Char(64)
  createdAt       DateTime    @default(now())
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]

  @@index([email])
  @@index([status, createdAt])
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  orderId        Int
  variantId      Int?
  nameSnapshot   String
  skuSnapshot    String
  size           String
  color          String
  qty            Int
  unitPricePaisa Int
  designId       Int?
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  design         CustomDesign?   @relation(fields: [designId], references: [id], onDelete: SetNull)
}

model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int
  method      String
  status      PaymentStatus @default(PENDING)
  amountPaisa Int
  providerRef String?
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id])

  @@unique([method, providerRef])
}

model Shipment {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  carrier        String   @default("LEOPARDS")
  trackingNumber String?  @unique
  status         String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
}
