# Backend runtime: NODE_ENV is development, test, or production; PORT is 1-65535.
NODE_ENV=development
PORT=4000

# Trust only the actual proxy hops in front of this API. Production must set this explicitly.
# Example: Cloudflare directly to the app = 1; Cloudflare plus Nginx = 2.
TRUST_PROXY=0
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins; CLIENT_ORIGIN is always included.
CLIENT_ORIGINS=
SITE_URL=http://localhost:5173
API_URL=http://localhost:4000
ADMIN_NOTIFY_EMAIL=owner@example.com

# MySQL connection. Use a dedicated non-root account; DATABASE_URL takes precedence when set.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zavikoo_atelier
DB_USER=zavikoo_app
DB_PASSWORD=replace-locally
DB_CONNECTION_LIMIT=10
DATABASE_URL="mysql://zavikoo_app:replace-locally@127.0.0.1:3306/zavikoo_atelier?connection_limit=10"

# Replace locally. Production requires a secret generated from at least 48 random bytes.
SESSION_SECRET=placeholder-generate-a-unique-random-secret

# OAuth Web client ID (public identifier, not a secret); must match the frontend configuration.
GOOGLE_CLIENT_ID=

# SMTP is optional locally; production requires SMTP_USER and SMTP_PASS together.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional integrations.
REDIS_URL=
SENTRY_DSN=

# Optional S3-compatible storage settings for the Phase 2 storage integration.
# Configure endpoint, bucket, access key, and secret key together when enabled.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Reserved integrations are not currently consumed by the application.
WHATSAPP_TOKEN=
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=

# Optional inputs for the interactive local admin-creation script.
ADMIN_EMAIL=
ADMIN_NAME=
